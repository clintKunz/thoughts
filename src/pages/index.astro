---
import { getCollection } from 'astro:content';
import ArticleList from '../components/ArticleList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest, isPublished } from '../lib/articles';

const articles = (await getCollection('articles')).filter(isPublished).sort(byNewest);
---

<BaseLayout>
  <div class="intro">
    <p>
      I write these notes to think more clearly about two things: how software actually
      gets built, and how a business stays worth building. Most of it is what I learned
      recently and did not want to forget.
    </p>
    <p class="meta">
      Everything here is a work in progress. <a href="/rss.xml">RSS</a>.
    </p>
  </div>

  <h1>Articles</h1>
  <ArticleList articles={articles} />
</BaseLayout>
