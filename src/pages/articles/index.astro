---
import { getCollection } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, isPublished } from '../../lib/articles';

const articles = (await getCollection('articles')).filter(isPublished).sort(byNewest);
const years = [...new Set(articles.map((article) => article.data.publishedAt.getFullYear()))];
---

<BaseLayout title="Articles" description="Every article, newest first.">
  <h1>Articles</h1>
  <p class="meta">{articles.length} in total, newest first.</p>

  {
    years.map((year) => (
      <>
        <p class="section-label">{year}</p>
        <ArticleList articles={articles.filter((a) => a.data.publishedAt.getFullYear() === year)} />
      </>
    ))
  }
</BaseLayout>
